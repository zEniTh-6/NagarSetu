# Copy to .env (repo root) and replace the placeholder values. Never commit .env.
# Both docker-compose.yml and the server read this one file.

# --- Database (used by docker-compose.yml) ---
POSTGRES_USER=nagarsetu
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nagarsetu
# Host port on your machine. Change it if 5432 is already in use.
POSTGRES_PORT=5432

# --- Server ---
NODE_ENV=development
PORT=4000
# The only origin allowed by CORS (the Vite dev server).
WEB_ORIGIN=http://localhost:5173
# Maximum JSON request body size.
JSON_BODY_LIMIT=100kb

# Keep user, password, port and database in sync with the values above.
DATABASE_URL=postgresql://nagarsetu:change_me@localhost:5432/nagarsetu
# Separate database for automated tests. Its name MUST end in _test (tests wipe it).
# The test setup creates it on first run.
TEST_DATABASE_URL=postgresql://nagarsetu:change_me@localhost:5432/nagarsetu_test

# --- Auth ---
# Long random strings, different from each other. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string
OTP_SECRET=change_me_to_another_long_random_string
# bcrypt work factor (12 is a good default; tests use 4 automatically).
BCRYPT_COST=12

# --- Email (signup OTP and password reset links only) ---
# log  = print emails (with the OTP / reset link) in the server console. Good for development.
# smtp = really send them (fill in the SMTP_* lines).
MAIL_TRANSPORT=log
MAIL_FROM="NagarSetu <no-reply@nagarsetu.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
