# Copy to .env (repo root) and replace the placeholder values. Never commit .env.
# Both docker-compose.yml and the server read this one file.

# --- Database (used by docker-compose.yml) ---
POSTGRES_USER=nagarsetu
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nagarsetu
# Host port on your machine. Change it if 5432 is already in use.
POSTGRES_PORT=5432

# --- Server ---
NODE_ENV=development
PORT=4000
# The only origin allowed by CORS (the Vite dev server).
WEB_ORIGIN=http://localhost:5173
# Maximum JSON request body size.
JSON_BODY_LIMIT=100kb

# Keep user, password, port and database in sync with the values above.
DATABASE_URL=postgresql://nagarsetu:change_me@localhost:5432/nagarsetu
# Separate database for automated tests. Its name MUST end in _test (tests wipe it).
# The test setup creates it on first run.
TEST_DATABASE_URL=postgresql://nagarsetu:change_me@localhost:5432/nagarsetu_test

# --- Auth ---
# Long random strings, different from each other. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string
OTP_SECRET=change_me_to_another_long_random_string
# bcrypt work factor (12 is a good default; tests use 4 automatically).
BCRYPT_COST=12

# --- Email (signup OTP and password reset links only) ---
# log  = print emails (with the OTP / reset link) in the server console. Good for development.
# smtp = really send them (fill in the SMTP_* lines).
MAIL_TRANSPORT=log
MAIL_FROM="NagarSetu <no-reply@nagarsetu.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- AI (Gemini) ---
# Key from https://aistudio.google.com (Get API key). Never commit it or paste it in chat.
# Without a key the server still runs; photo checks stay "pending" until it is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000
# Text embeddings for the duplicate check (same key). Changing the model means re-embedding all reports.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBED_TIMEOUT_MS=15000
# Text similarity (0–1) from which a nearby same-category report counts as a possible duplicate.
# 0.80 chosen from `npm run ai:similarity` (see D-016 in docs/decisions.md).
DUPLICATE_SIMILARITY_THRESHOLD=0.80

# --- Admin review: community signal ---
# "Low supporter diversity" warning when at least LOW_DIVERSITY_MIN_ACCOUNTS distinct accounts
# back an issue and at least LOW_DIVERSITY_NEW_SHARE (0–1) of them are younger than
# NEW_ACCOUNT_DAYS days. Information only; starting values (D-018).
LOW_DIVERSITY_MIN_ACCOUNTS=5
LOW_DIVERSITY_NEW_SHARE=0.5
NEW_ACCOUNT_DAYS=7

# --- Uploads ---
# Folder for photos (relative to server/). Gitignored.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# --- Service area (reports outside it are refused) ---
# minLng,minLat,maxLng,maxLat — SMKC: 16°46'28"–16°53'45" N, 74°31'08"–74°40'51" E
SERVICE_AREA_BBOX=74.518889,16.774444,74.680833,16.895833

# --- Background jobs (pg-boss, runs inside npm run dev) ---
JOBS_ENABLED=true
